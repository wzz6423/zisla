<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <QPDFPrefix Condition="'$(QPDFPrefix)'==''">$(LOCALAPPDATA)\zisla\build\qpdf\$(Platform)\$(Configuration)\prefix</QPDFPrefix>
    <QPDFIncludeDirectory>$(QPDFPrefix)\include</QPDFIncludeDirectory>
    <QPDFLibraryDirectory>$(QPDFPrefix)\lib</QPDFLibraryDirectory>
    <QPDFZlibLibrary Condition="'$(Configuration)'=='Debug'">zsd.lib</QPDFZlibLibrary>
    <QPDFZlibLibrary Condition="'$(Configuration)'!='Debug'">zs.lib</QPDFZlibLibrary>
  </PropertyGroup>
</Project>
