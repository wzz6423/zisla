<UserControl
    x:Class="Zisla.AIAgentWorkspaceContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid MinHeight="260" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock
                    Foreground="{ThemeResource OverlayPrimaryTextBrush}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="会话" />
                <TextBlock
                    x:Name="WorkspaceStatusText"
                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                    FontSize="10"
                    Text="正在加载本地工作区"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button
                x:Name="NewThreadButton"
                Grid.Column="1"
                Width="34"
                Height="34"
                Padding="0"
                AutomationProperties.Name="新建 AI Agent 会话"
                Click="NewThreadButton_Click"
                ToolTipService.ToolTip="新建会话">
                <FontIcon FontSize="13" Glyph="&#xE710;" />
            </Button>
            <Button
                x:Name="RemoveThreadButton"
                Grid.Column="2"
                Width="34"
                Height="34"
                Margin="4,0,0,0"
                Padding="0"
                AutomationProperties.Name="删除当前 AI Agent 会话"
                Click="RemoveThreadButton_Click"
                ToolTipService.ToolTip="删除会话">
                <FontIcon FontSize="13" Glyph="&#xE74D;" />
            </Button>
        </Grid>

        <TextBlock
            x:Name="WorkspaceErrorText"
            Grid.Row="1"
            Foreground="{ThemeResource OverlayDangerBrush}"
            FontSize="10"
            TextWrapping="Wrap"
            VerticalAlignment="Top"
            Visibility="Collapsed" />

        <Expander
            x:Name="ConnectionExpander"
            Grid.Row="2"
            Margin="0,2,0,0"
            Header="AI API 渠道">
            <Grid Margin="0,8,0,2" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                    FontSize="10"
                    Text="渠道" />
                <ComboBox
                    x:Name="ConnectionSelectorBox"
                    Grid.Column="1"
                    AutomationProperties.Name="AI Agent API 渠道"
                    SelectionChanged="ConnectionSelectorBox_SelectionChanged"
                    ToolTipService.ToolTip="选择用于当前会话的 API 渠道" />
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        x:Name="NewConnectionButton"
                        Width="34"
                        Height="34"
                        Padding="0"
                        AutomationProperties.Name="新建 AI API 渠道"
                        Click="NewConnectionButton_Click"
                        ToolTipService.ToolTip="新建 API 渠道">
                        <FontIcon FontSize="13" Glyph="&#xE710;" />
                    </Button>
                    <Button
                        x:Name="RemoveConnectionButton"
                        Width="34"
                        Height="34"
                        Padding="0"
                        AutomationProperties.Name="删除当前 AI API 渠道"
                        Click="RemoveConnectionButton_Click"
                        ToolTipService.ToolTip="删除当前 API 渠道">
                        <FontIcon FontSize="13" Glyph="&#xE74D;" />
                    </Button>
                </StackPanel>
                <TextBlock
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                    FontSize="10"
                    Text="渠道名" />
                <TextBox
                    x:Name="ConnectionNameBox"
                    Grid.Row="1"
                    Grid.Column="1"
                    AutomationProperties.Name="AI Agent 渠道名称"
                    MaxLength="128"
                    PlaceholderText="AI API" />
                <TextBlock
                    Grid.Row="2"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                    FontSize="10"
                    Text="协议" />
                <ComboBox
                    x:Name="ConnectionProtocolBox"
                    Grid.Row="2"
                    Grid.Column="1"
                    AutomationProperties.Name="AI Agent API 协议"
                    SelectedIndex="0">
                    <ComboBoxItem Tag="openai-compatible">OpenAI-compatible</ComboBoxItem>
                    <ComboBoxItem Tag="anthropic-messages">Anthropic Messages</ComboBoxItem>
                    <ComboBoxItem Tag="gemini-generate-content">Gemini generateContent</ComboBoxItem>
                </ComboBox>
                <TextBlock
                    Grid.Row="3"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                    FontSize="10"
                    Text="Base URL" />
                <TextBox
                    x:Name="ConnectionBaseUrlBox"
                    Grid.Row="3"
                    Grid.Column="1"
                    AcceptsReturn="True"
                    AutomationProperties.Name="AI Agent Base URL"
                    MaxLength="2048"
                    MinHeight="34"
                    PlaceholderText="每行一个地址"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Row="4"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                    FontSize="10"
                    Text="模型" />
                <TextBox
                    x:Name="ConnectionModelBox"
                    Grid.Row="4"
                    Grid.Column="1"
                    AutomationProperties.Name="AI Agent 模型"
                    MaxLength="256"
                    PlaceholderText="模型 ID" />
                <Button
                    x:Name="RefreshModelsButton"
                    Grid.Row="4"
                    Grid.Column="2"
                    Width="34"
                    Height="34"
                    Padding="0"
                    AutomationProperties.Name="刷新 AI Agent 模型目录"
                    Click="RefreshModelsButton_Click"
                    ToolTipService.ToolTip="刷新模型目录">
                    <FontIcon FontSize="13" Glyph="&#xE72C;" />
                </Button>
                <TextBlock
                    Grid.Row="5"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                    FontSize="10"
                    Text="模型目录" />
                <ComboBox
                    x:Name="ModelCatalogBox"
                    Grid.Row="5"
                    Grid.Column="1"
                    AutomationProperties.Name="AI Agent 模型目录"
                    SelectionChanged="ModelCatalogBox_SelectionChanged"
                    ToolTipService.ToolTip="从已刷新的模型目录选择模型" />
                <TextBlock
                    Grid.Row="6"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                    FontSize="10"
                    Text="端点优先级" />
                <NumberBox
                    x:Name="EndpointPriorityBox"
                    Grid.Row="6"
                    Grid.Column="1"
                    AutomationProperties.Name="AI Agent 端点优先级"
                    Maximum="99"
                    Minimum="-99"
                    SmallChange="1"
                    SpinButtonPlacementMode="Compact"
                    Value="0" />
                <TextBlock
                    Grid.Row="7"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                    FontSize="10"
                    Text="API Key" />
                <PasswordBox
                    x:Name="ConnectionApiKeyBox"
                    Grid.Row="7"
                    Grid.Column="1"
                    AutomationProperties.Name="AI Agent API Key"
                    MaxLength="512"
                    PlaceholderText="留空可保留已保存的密钥"
                    ToolTipService.ToolTip="密钥仅保存到 Windows Credential Manager" />
                <TextBlock
                    Grid.Row="8"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                    FontSize="10"
                    Text="余额检测" />
                <ComboBox
                    x:Name="BalanceProbeBox"
                    Grid.Row="8"
                    Grid.Column="1"
                    AutomationProperties.Name="AI Agent 余额检测"
                    SelectedIndex="0">
                    <ComboBoxItem Tag="none">不检测</ComboBoxItem>
                    <ComboBoxItem Tag="openai-credits">OpenAI Credits</ComboBoxItem>
                    <ComboBoxItem Tag="anthropic-usage">Anthropic Usage</ComboBoxItem>
                    <ComboBoxItem Tag="new-api-quota">New API Quota</ComboBoxItem>
                </ComboBox>
                <Button
                    x:Name="RefreshBalanceButton"
                    Grid.Row="8"
                    Grid.Column="2"
                    Width="34"
                    Height="34"
                    Padding="0"
                    AutomationProperties.Name="刷新 AI Agent 余额"
                    Click="RefreshBalanceButton_Click"
                    ToolTipService.ToolTip="刷新余额">
                    <FontIcon FontSize="13" Glyph="&#xE72C;" />
                </Button>
                <Button
                    x:Name="SaveConnectionButton"
                    Grid.Row="9"
                    Grid.Column="2"
                    Width="34"
                    Height="34"
                    Padding="0"
                    AutomationProperties.Name="保存 AI API 连接"
                    Click="SaveConnectionButton_Click"
                    ToolTipService.ToolTip="保存 API 连接">
                    <FontIcon FontSize="13" Glyph="&#xE74E;" />
                </Button>
                <TextBlock
                    x:Name="ConnectionStatusText"
                    Grid.Row="9"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                    FontSize="10"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Expander>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="126" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Column="0">
                <ListView
                    x:Name="ThreadList"
                    AutomationProperties.Name="AI Agent 会话列表"
                    SelectionChanged="ThreadList_SelectionChanged"
                    SelectionMode="Single"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <TextBlock
                    x:Name="ThreadEmptyText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                    FontSize="10"
                    IsHitTestVisible="False"
                    Text="暂无会话"
                    TextAlignment="Center"
                    Visibility="Collapsed" />
            </Grid>
            <Border
                Grid.Column="1"
                Background="{ThemeResource OverlayStrokeBrush}" />
            <Grid Grid.Column="2">
                <ScrollViewer
                    x:Name="MessageScrollViewer"
                    AutomationProperties.Name="当前会话记录"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MessageRows" Spacing="7" />
                </ScrollViewer>
                <TextBlock
                    x:Name="MessageEmptyText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                    FontSize="11"
                    IsHitTestVisible="False"
                    Text="选择或新建一个会话"
                    TextAlignment="Center" />
            </Grid>
        </Grid>

        <Grid Grid.Row="4" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="ComposerBox"
                AcceptsReturn="True"
                AutomationProperties.Name="AI Agent 消息"
                IsSpellCheckEnabled="True"
                MaxLength="1048576"
                MinHeight="44"
                PlaceholderText="输入消息"
                TextWrapping="Wrap"
                VerticalContentAlignment="Top" />
            <ComboBox
                x:Name="ExecutionTargetBox"
                Grid.Column="1"
                Width="92"
                AutomationProperties.Name="AI Agent 执行来源"
                SelectionChanged="ExecutionTargetBox_SelectionChanged"
                ToolTipService.ToolTip="选择 OpenAI-compatible 或本机官方 CLI">
                <ComboBoxItem Tag="api">API</ComboBoxItem>
                <ComboBoxItem Tag="claude">Claude</ComboBoxItem>
                <ComboBoxItem Tag="codex">Codex</ComboBoxItem>
                <ComboBoxItem Tag="gemini">Gemini</ComboBoxItem>
                <ComboBoxItem Tag="grok">Grok</ComboBoxItem>
                <ComboBoxItem Tag="opencode">OpenCode</ComboBoxItem>
            </ComboBox>
            <Button
                x:Name="CancelRequestButton"
                Grid.Column="2"
                Width="38"
                MinHeight="44"
                Padding="0"
                AutomationProperties.Name="取消 AI Agent CLI 请求"
                Click="CancelRequestButton_Click"
                ToolTipService.ToolTip="取消 CLI 请求"
                Visibility="Collapsed">
                <FontIcon FontSize="13" Glyph="&#xE711;" />
            </Button>
            <Button
                x:Name="SendButton"
                Grid.Column="3"
                Width="38"
                MinHeight="44"
                Padding="0"
                AutomationProperties.Name="保存 AI Agent 消息"
                Click="SendButton_Click"
                ToolTipService.ToolTip="保存消息">
                <FontIcon FontSize="13" Glyph="&#xE724;" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
