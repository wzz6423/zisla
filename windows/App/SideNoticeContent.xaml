<UserControl
    x:Class="Zisla.SideNoticeContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        x:Name="Surface"
        AutomationProperties.LiveSetting="Polite"
        Background="{ThemeResource OverlaySurfaceBrush}"
        BorderBrush="{ThemeResource OverlayStrokeBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource OverlayCornerRadius}">
        <StackPanel x:Name="NoticeRows" Spacing="6" />
    </Border>
</UserControl>
