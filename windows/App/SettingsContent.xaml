<UserControl
    x:Class="Zisla.SettingsContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <NavigationView
        x:Name="Navigation"
        AlwaysShowHeader="False"
        IsBackButtonVisible="Collapsed"
        IsPaneOpen="True"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        OpenPaneLength="190"
        PaneDisplayMode="Left"
        Background="{ThemeResource SettingsSurfaceBrush}"
        SelectionChanged="Navigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="常规" IsSelected="True" Tag="general">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="剪贴板" Tag="clipboard">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8C8;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="信息" Tag="info">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE9CA;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="交互" Tag="interaction">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE7C9;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="邮箱" Tag="mail">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE715;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="更新" Tag="updates">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE72C;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItemSeparator />
            <NavigationViewItem Content="关于" Tag="about">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid Padding="28,22,32,28">
            <ScrollViewer x:Name="GeneralPage">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left" Spacing="20">
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="常规" />
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="入口" />
                        <ToggleSwitch
                            x:Name="TopEdgeToggle"
                            AutomationProperties.Name="顶部悬停入口"
                            Header="顶部悬停入口"
                            OffContent="关闭"
                            OnContent="开启"
                            Toggled="TopEdgeToggle_Toggled" />
                        <ToggleSwitch
                            x:Name="TaskbarWidgetToggle"
                            AutomationProperties.Name="任务栏内部组件"
                            Header="任务栏内部组件（实验）"
                            OffContent="关闭"
                            OnContent="开启"
                            Toggled="TaskbarWidgetToggle_Toggled" />
                        <ComboBox
                            x:Name="TaskbarWidgetPositionPicker"
                            AutomationProperties.Name="任务栏组件位置"
                            Header="任务栏组件位置"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="TaskbarWidgetPositionPicker_SelectionChanged">
                            <ComboBoxItem Content="任务栏起始位置" Tag="leading" />
                            <ComboBoxItem Content="Windows 图标左侧" Tag="before-start" />
                            <ComboBoxItem Content="右侧系统区域左侧" Tag="trailing" />
                        </ComboBox>
                        <ToggleSwitch
                            x:Name="StartupTaskToggle"
                            AutomationProperties.Name="登录时启动"
                            Header="登录时启动"
                            IsEnabled="False"
                            OffContent="关闭"
                            OnContent="开启"
                            Toggled="StartupTaskToggle_Toggled" />
                        <TextBlock
                            x:Name="StartupTaskStatusText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="12"
                            Text="正在读取启动项状态"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="OpenStartupSettingsButton"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="打开 Windows 启动应用设置"
                            Click="OpenStartupSettingsButton_Click"
                            Content="打开启动应用设置"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="通知" />
                        <ToggleSwitch
                            x:Name="SideNoticesToggle"
                            AutomationProperties.Name="侧边活动通知"
                            Header="侧边活动通知"
                            OffContent="关闭"
                            OnContent="开启"
                            Toggled="SideNoticesToggle_Toggled" />
                        <ToggleSwitch
                            x:Name="NotificationsMutedToggle"
                            AutomationProperties.Name="屏蔽通知"
                            Header="屏蔽通知"
                            OffContent="正常推送"
                            OnContent="已屏蔽"
                            Toggled="NotificationsMutedToggle_Toggled" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ClipboardPage" Visibility="Collapsed">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left" Spacing="20">
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="剪贴板" />
                    <StackPanel Spacing="8">
                        <ToggleSwitch
                            x:Name="ClipboardHistoryToggle"
                            AutomationProperties.Name="记录剪贴板历史"
                            Header="记录剪贴板历史"
                            OffContent="关闭"
                            OnContent="开启"
                            Toggled="ClipboardHistoryToggle_Toggled" />
                        <ToggleSwitch
                            x:Name="ClipboardDetectionToggle"
                            AutomationProperties.Name="检测剪贴板链接"
                            Header="检测剪贴板链接"
                            OffContent="关闭"
                            OnContent="开启"
                            Toggled="ClipboardDetectionToggle_Toggled" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="InfoPage" Visibility="Collapsed">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left" Spacing="20">
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="信息" />
                    <StackPanel Spacing="8">
                        <ToggleSwitch
                            x:Name="WeatherToggle"
                            AutomationProperties.Name="天气"
                            Header="天气"
                            OffContent="关闭"
                            OnContent="开启"
                            Toggled="WeatherToggle_Toggled" />
                        <ToggleSwitch
                            x:Name="BrowserDownloadStatusToggle"
                            AutomationProperties.Name="浏览器下载状态"
                            Header="浏览器下载状态"
                            OffContent="关闭"
                            OnContent="开启"
                            Toggled="BrowserDownloadStatusToggle_Toggled" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="InteractionPage" Visibility="Collapsed">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left" Spacing="20">
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="交互" />
                    <StackPanel Spacing="8">
                        <ToggleSwitch
                            x:Name="VoiceInputToggle"
                            AutomationProperties.Name="语音输入"
                            Header="语音输入"
                            OffContent="关闭"
                            OnContent="开启"
                            Toggled="VoiceInputToggle_Toggled" />
                        <ComboBox
                            x:Name="VoiceHotkeyActionPicker"
                            AutomationProperties.Name="触发方式"
                            Header="触发方式"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="VoiceHotkeyActionPicker_SelectionChanged">
                            <ComboBoxItem Content="切换" Tag="toggle" />
                            <ComboBoxItem Content="按住说话" Tag="push-to-talk" />
                        </ComboBox>
                        <ComboBox
                            x:Name="VoiceHotkeyPresetPicker"
                            AutomationProperties.Name="快捷键"
                            Header="快捷键"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="VoiceHotkeyPresetPicker_SelectionChanged">
                            <ComboBoxItem Content="Ctrl+Alt+V" Tag="control-alt-v" />
                            <ComboBoxItem Content="Ctrl+Alt+Space" Tag="control-alt-space" />
                            <ComboBoxItem Content="Ctrl+Alt+R" Tag="control-alt-r" />
                        </ComboBox>
                        <TextBlock
                            x:Name="VoiceHotkeyStatusText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="12"
                            Text="快捷键状态"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="MailPage" Visibility="Collapsed">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left" Spacing="20">
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="邮箱" />
                    <StackPanel Spacing="8">
                        <TextBox
                            x:Name="MailTenantBox"
                            Header="Microsoft Graph 租户"
                            MaxLength="128"
                            PlaceholderText="common" />
                        <TextBox
                            x:Name="MailClientIdBox"
                            Header="Public Client ID"
                            MaxLength="128"
                            PlaceholderText="Microsoft Entra 应用的客户端 ID" />
                        <TextBox
                            x:Name="MailAccountNameBox"
                            Header="邮箱显示名（可选）"
                            MaxLength="256"
                            PlaceholderText="例如：工作邮箱" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="MailSaveButton"
                                AutomationProperties.Name="保存邮箱设置"
                                Click="MailSaveButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE74E;" />
                                    <TextBlock Text="保存邮箱设置" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="MailAuthorizeButton"
                                AutomationProperties.Name="开始 Microsoft 登录"
                                Click="MailAuthorizeButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE8FA;" />
                                    <TextBlock Text="开始 Microsoft 登录" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock
                            x:Name="MailStatusText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="12"
                            Text="尚未连接"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="MailVerificationCodeText"
                            FontFamily="Consolas"
                            FontSize="16"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="MailVerificationUriText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="11"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="MailOpenAuthorizationButton"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="打开 Microsoft 登录页面"
                            Click="MailOpenAuthorizationButton_Click"
                            Content="打开 Microsoft 登录页面"
                            Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="UpdatesPage" Visibility="Collapsed">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left" Spacing="20">
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="更新" />
                    <StackPanel Spacing="8">
                        <ComboBox
                            x:Name="UpdateChannelPicker"
                            AutomationProperties.Name="更新通道"
                            Header="更新通道"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="UpdateChannelPicker_SelectionChanged">
                            <ComboBoxItem Content="正式版" Tag="release" />
                            <ComboBoxItem Content="预览版" Tag="preview" />
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="UpdateCheckButton"
                                AutomationProperties.Name="检查更新"
                                Click="UpdateCheckButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE72C;" />
                                    <TextBlock Text="检查更新" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="UpdateOpenButton"
                                AutomationProperties.Name="打开可用更新"
                                Click="UpdateOpenButton_Click"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                                    <TextBlock Text="打开更新" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock
                            x:Name="UpdateStatusText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="12"
                            Text="尚未检查更新"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AboutPage" Visibility="Collapsed">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left" Spacing="12">
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="关于" />
                    <TextBlock
                        x:Name="AppVersionText"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Zisla" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </NavigationView>
</UserControl>
