<UserControl
    x:Class="Zisla.TeleprompterContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <FontIcon
                x:Name="EmptyIcon"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="#4DFFFFFF"
                FontSize="38"
                Glyph="&#xE8D2;" />
            <ScrollViewer
                x:Name="ScriptScroll"
                AutomationProperties.Name="提词器文本"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                ZoomMode="Disabled">
                <TextBlock
                    x:Name="ScriptText"
                    Margin="48,54"
                    Foreground="White"
                    FontSize="34"
                    FontWeight="Medium"
                    IsTextSelectionEnabled="True"
                    LineHeight="52"
                    TextWrapping="Wrap" />
            </ScrollViewer>
        </Grid>

        <Border
            Grid.Row="1"
            Margin="18"
            Padding="10"
            Background="#D91A1A1A"
            CornerRadius="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="132" />
                    <ColumnDefinition Width="68" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="PlayPauseButton"
                    Width="36"
                    Height="36"
                    Padding="0"
                    AutomationProperties.Name="开始自动滚动"
                    Click="PlayPauseButton_Click"
                    ToolTipService.ToolTip="开始自动滚动">
                    <FontIcon
                        x:Name="PlayPauseIcon"
                        FontSize="14"
                        Glyph="&#xE768;" />
                </Button>
                <Button
                    Grid.Column="1"
                    Width="36"
                    Height="36"
                    Padding="0"
                    AutomationProperties.Name="回到开头"
                    Click="ResetButton_Click"
                    ToolTipService.ToolTip="回到开头">
                    <FontIcon FontSize="14" Glyph="&#xE777;" />
                </Button>
                <Slider
                    x:Name="SpeedSlider"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="自动滚动速度"
                    Maximum="150"
                    Minimum="15"
                    StepFrequency="5"
                    Value="45"
                    ValueChanged="SpeedSlider_ValueChanged" />
                <TextBlock
                    x:Name="SpeedText"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Foreground="#D9FFFFFF"
                    FontFamily="Consolas"
                    FontSize="11"
                    Text="45 px/s"
                    TextAlignment="Right" />
                <Button
                    Grid.Column="4"
                    Width="36"
                    Height="36"
                    Padding="0"
                    AutomationProperties.Name="从剪贴板粘贴"
                    Click="PasteButton_Click"
                    ToolTipService.ToolTip="从剪贴板粘贴">
                    <FontIcon FontSize="14" Glyph="&#xE77F;" />
                </Button>
                <Button
                    Grid.Column="6"
                    Width="36"
                    Height="36"
                    Padding="0"
                    AutomationProperties.Name="关闭提词器"
                    Click="CloseButton_Click"
                    ToolTipService.ToolTip="关闭">
                    <FontIcon FontSize="13" Glyph="&#xE8BB;" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
