<UserControl
    x:Class="Zisla.OverlayContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Zisla"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        x:Name="SurfaceBorder"
        Background="{ThemeResource OverlaySurfaceBrush}"
        BorderBrush="{ThemeResource OverlayStrokeBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource OverlayCornerRadius}">
        <Grid>
            <Grid
                x:Name="PeekLayout"
                Padding="18,14"
                AutomationProperties.Name="Zisla 状态预览">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="PeekArtworkContainer"
                    Width="38"
                    Height="38"
                    VerticalAlignment="Center"
                    Background="{ThemeResource OverlayAccentBrush}"
                    CornerRadius="8">
                    <Grid>
                        <Image
                            x:Name="PeekArtwork"
                            Stretch="UniformToFill"
                            Visibility="Collapsed" />
                        <FontIcon
                            x:Name="PeekFallbackIcon"
                            Foreground="White"
                            FontSize="18"
                            Glyph="&#xE945;" />
                    </Grid>
                </Border>

                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,8,0"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        x:Name="PeekTitle"
                        Foreground="{ThemeResource OverlayPrimaryTextBrush}"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="Zisla" />
                    <TextBlock
                        x:Name="PeekDetail"
                        Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                        FontSize="12"
                        Text="暂无进行中的活动"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <ProgressRing
                    x:Name="PeekProgressRing"
                    Grid.Column="2"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />
                <FontIcon
                    x:Name="PeekPlaybackIcon"
                    Grid.Column="2"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                    FontSize="14"
                    Glyph="&#xE769;"
                    Visibility="Collapsed" />
            </Grid>

            <Grid x:Name="InteractiveLayout" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="14,8,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock
                            Foreground="{ThemeResource OverlayPrimaryTextBrush}"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="Zisla" />
                        <TextBlock
                            Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                            FontSize="11"
                            Text="Windows" />
                    </StackPanel>

                    <Button
                        x:Name="PinButton"
                        Grid.Column="1"
                        Width="34"
                        Height="34"
                        Padding="0"
                        AutomationProperties.Name="固定窗口"
                        Click="PinButton_Click"
                        ToolTipService.ToolTip="固定窗口">
                        <FontIcon x:Name="PinIcon" FontSize="14" Glyph="&#xE840;" />
                    </Button>
                    <Button
                        x:Name="VoiceInputButton"
                        Grid.Column="2"
                        Width="34"
                        Height="34"
                        Margin="4,0,0,0"
                        Padding="0"
                        AutomationProperties.Name="开始语音输入"
                        Click="VoiceInputButton_Click"
                        ToolTipService.ToolTip="开始语音输入"
                        Visibility="Collapsed">
                        <FontIcon x:Name="VoiceInputIcon" FontSize="14" Glyph="&#xE720;" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        Width="34"
                        Height="34"
                        Margin="4,0,0,0"
                        Padding="0"
                        AutomationProperties.Name="打开设置"
                        Click="SettingsButton_Click"
                        ToolTipService.ToolTip="设置">
                        <FontIcon FontSize="14" Glyph="&#xE713;" />
                    </Button>
                    <Button
                        Grid.Column="4"
                        Width="34"
                        Height="34"
                        Margin="4,0,0,0"
                        Padding="0"
                        AutomationProperties.Name="关闭窗口"
                        Click="CloseButton_Click"
                        ToolTipService.ToolTip="关闭">
                        <FontIcon FontSize="14" Glyph="&#xE8BB;" />
                    </Button>
                </Grid>

                <Grid
                    x:Name="VoiceInputStatusBar"
                    Grid.Row="1"
                    Margin="14,0,8,6"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="语音输入状态"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        x:Name="VoiceInputStatusIcon"
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource OverlayAccentBrush}"
                        FontSize="14"
                        Glyph="&#xE720;" />
                    <TextBlock
                        x:Name="VoiceInputStatusText"
                        Grid.Column="1"
                        Margin="8,0"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                        FontSize="12"
                        TextTrimming="CharacterEllipsis" />
                    <ProgressRing
                        x:Name="VoiceInputProgressRing"
                        Grid.Column="2"
                        Width="18"
                        Height="18"
                        IsActive="False"
                        Visibility="Collapsed" />
                </Grid>

                <NavigationView
                    x:Name="ModuleNavigation"
                    Grid.Row="2"
                    AlwaysShowHeader="False"
                    Background="Transparent"
                    IsBackButtonVisible="Collapsed"
                    IsPaneOpen="False"
                    IsPaneToggleButtonVisible="False"
                    IsSettingsVisible="False"
                    OpenPaneLength="150"
                    PaneDisplayMode="LeftCompact"
                    SelectionChanged="ModuleNavigation_SelectionChanged">
                    <NavigationView.MenuItems>
                        <NavigationViewItem
                            Content="首页"
                            IsSelected="True"
                            Tag="dashboard"
                            ToolTipService.ToolTip="首页">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE80F;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="中转" Tag="shelf" ToolTipService.ToolTip="文件中转">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE838;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="剪贴板" Tag="clipboard" ToolTipService.ToolTip="剪贴板">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE8C8;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="AI 监控" Tag="ai" ToolTipService.ToolTip="AI 监控">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="AI Agent" Tag="agent" ToolTipService.ToolTip="AI Agent">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE945;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="下载" Tag="download" ToolTipService.ToolTip="下载">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="日程" Tag="agenda" ToolTipService.ToolTip="日程与天气">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE787;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="邮件" Tag="mail" ToolTipService.ToolTip="邮件">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE715;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="随记" Tag="notes" ToolTipService.ToolTip="随记">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE70B;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="PDF" Tag="pdf" ToolTipService.ToolTip="PDF 工具">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="小工具" Tag="toolbox" ToolTipService.ToolTip="小工具">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="系统" Tag="system" ToolTipService.ToolTip="系统监控">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationView.MenuItems>

                    <Grid Padding="16,8,18,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Name="ModuleTitle"
                            Foreground="{ThemeResource OverlayPrimaryTextBrush}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="首页" />
                        <StackPanel
                            x:Name="ModuleState"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <FontIcon
                                x:Name="ModuleStateIcon"
                                Foreground="{ThemeResource OverlayAccentBrush}"
                                FontSize="28"
                                Glyph="&#xE73E;" />
                            <TextBlock
                                x:Name="ModuleStateText"
                                Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                FontSize="13"
                                Text="一切就绪"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ScrollViewer
                            x:Name="DashboardScroll"
                            Grid.Row="1"
                            AutomationProperties.Name="首页活动"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="Collapsed">
                            <StackPanel Spacing="10">
                                <Button
                                    x:Name="DashboardFocusButton"
                                    Padding="4,8"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="专注倒计时"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="DashboardFocusButton_Click"
                                    Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="34"
                                            Height="34"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource OverlayAccentBrush}"
                                            CornerRadius="8">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="White"
                                                FontSize="16"
                                                Glyph="&#xE823;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0" Spacing="2">
                                            <TextBlock
                                                x:Name="DashboardFocusTitle"
                                                Foreground="{ThemeResource OverlayPrimaryTextBrush}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Text="专注倒计时" />
                                            <TextBlock
                                                x:Name="DashboardFocusStatus"
                                                Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                FontSize="11"
                                                Text="进行中" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <TextBlock
                                                x:Name="DashboardFocusClock"
                                                Foreground="{ThemeResource OverlayPrimaryTextBrush}"
                                                FontFamily="Consolas"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="25:00" />
                                            <FontIcon
                                                Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                FontSize="12"
                                                Glyph="&#xE76C;" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Border
                                    x:Name="DashboardFocusDivider"
                                    Height="1"
                                    Background="{ThemeResource OverlayStrokeBrush}"
                                    Visibility="Collapsed" />
                                <Button
                                    x:Name="DashboardWeatherButton"
                                    Padding="4,8"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="天气"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="DashboardWeatherButton_Click"
                                    Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="34"
                                            Height="34"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource OverlayAccentBrush}"
                                            CornerRadius="8">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="White"
                                                FontSize="16"
                                                Glyph="&#xE706;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0" Spacing="2">
                                            <TextBlock
                                                x:Name="DashboardWeatherTitle"
                                                Foreground="{ThemeResource OverlayPrimaryTextBrush}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Text="天气" />
                                            <TextBlock
                                                x:Name="DashboardWeatherStatus"
                                                Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                FontSize="11"
                                                MaxLines="1"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <TextBlock
                                                x:Name="DashboardWeatherTemperature"
                                                Foreground="{ThemeResource OverlayPrimaryTextBrush}"
                                                FontSize="16"
                                                FontWeight="SemiBold" />
                                            <FontIcon
                                                Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                FontSize="12"
                                                Glyph="&#xE76C;" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Border
                                    x:Name="DashboardWeatherDivider"
                                    Height="1"
                                    Background="{ThemeResource OverlayStrokeBrush}"
                                    Visibility="Collapsed" />
                                <Button
                                    x:Name="DashboardAIButton"
                                    Padding="4,8"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="AI 工作"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="DashboardAIButton_Click"
                                    Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="34"
                                            Height="34"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource OverlayAccentBrush}"
                                            CornerRadius="8">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="White"
                                                FontSize="16"
                                                Glyph="&#xE945;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0" Spacing="2">
                                            <TextBlock
                                                x:Name="DashboardAITitle"
                                                Foreground="{ThemeResource OverlayPrimaryTextBrush}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                MaxLines="1"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                x:Name="DashboardAIStatus"
                                                Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                FontSize="11"
                                                MaxLines="1"
                                                TextTrimming="CharacterEllipsis" />
                                            <ProgressBar
                                                x:Name="DashboardAIProgress"
                                                Height="3"
                                                Margin="0,3,0,0"
                                                Maximum="1"
                                                Visibility="Collapsed" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <TextBlock
                                                x:Name="DashboardAICount"
                                                Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                FontSize="11" />
                                            <FontIcon
                                                Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                FontSize="12"
                                                Glyph="&#xE76C;" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Border
                                    x:Name="DashboardDivider"
                                    Height="1"
                                    Background="{ThemeResource OverlayStrokeBrush}"
                                    Visibility="Collapsed" />
                                <Button
                                    x:Name="DashboardDownloadButton"
                                    Padding="4,8"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="媒体下载"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="DashboardDownloadButton_Click"
                                    Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="34"
                                            Height="34"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource OverlayAccentBrush}"
                                            CornerRadius="8">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="White"
                                                FontSize="16"
                                                Glyph="&#xE896;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0" Spacing="3">
                                            <TextBlock
                                                x:Name="DashboardDownloadTitle"
                                                Foreground="{ThemeResource OverlayPrimaryTextBrush}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Text="媒体下载" />
                                            <TextBlock
                                                x:Name="DashboardDownloadStatus"
                                                Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                FontSize="11"
                                                MaxLines="1"
                                                TextTrimming="CharacterEllipsis" />
                                            <ProgressBar
                                                x:Name="DashboardDownloadProgress"
                                                Height="3"
                                                Margin="0,2,0,0"
                                                Maximum="1" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="DashboardDownloadPercent"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                            FontFamily="Consolas"
                                            FontSize="11" />
                                    </Grid>
                                </Button>
                                <Border
                                    x:Name="DashboardDownloadDivider"
                                    Height="1"
                                    Background="{ThemeResource OverlayStrokeBrush}"
                                    Visibility="Collapsed" />
                                <Button
                                    x:Name="DashboardBrowserDownloadButton"
                                    Padding="4,8"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="浏览器下载"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="DashboardBrowserDownloadButton_Click"
                                    Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="34"
                                            Height="34"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource OverlayAccentBrush}"
                                            CornerRadius="8">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="White"
                                                FontSize="16"
                                                Glyph="&#xE896;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0" Spacing="3">
                                            <TextBlock
                                                x:Name="DashboardBrowserDownloadTitle"
                                                Foreground="{ThemeResource OverlayPrimaryTextBrush}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Text="浏览器下载" />
                                            <TextBlock
                                                x:Name="DashboardBrowserDownloadStatus"
                                                Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                FontSize="11"
                                                MaxLines="1"
                                                TextTrimming="CharacterEllipsis" />
                                            <ProgressBar
                                                x:Name="DashboardBrowserDownloadProgress"
                                                Height="3"
                                                Margin="0,2,0,0"
                                                Maximum="1" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="DashboardBrowserDownloadPercent"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                            FontFamily="Consolas"
                                            FontSize="11" />
                                    </Grid>
                                </Button>
                                <Border
                                    x:Name="DashboardBrowserDownloadDivider"
                                    Height="1"
                                    Background="{ThemeResource OverlayStrokeBrush}"
                                    Visibility="Collapsed" />
                                <Grid
                                    x:Name="MediaView"
                                    Margin="4,0"
                                    AutomationProperties.Name="系统正在播放"
                                    Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="68"
                                Height="68"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{ThemeResource OverlayAccentBrush}"
                                CornerRadius="8">
                                <Grid>
                                    <Image
                                        x:Name="MediaArtwork"
                                        Stretch="UniformToFill"
                                        Visibility="Collapsed" />
                                    <FontIcon
                                        x:Name="MediaArtworkFallback"
                                        Foreground="White"
                                        FontSize="26"
                                        Glyph="&#xE8D6;" />
                                </Grid>
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    x:Name="MediaTitle"
                                    Foreground="{ThemeResource OverlayPrimaryTextBrush}"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="MediaArtist"
                                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                    FontSize="12"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="MediaSource"
                                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                    FontSize="11"
                                    MaxLines="1"
                                    Opacity="0.78"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="MediaElapsed"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                    FontSize="10"
                                    Text="0:00" />
                                <Slider
                                    x:Name="MediaProgress"
                                    Grid.Column="1"
                                    MinWidth="160"
                                    AutomationProperties.Name="播放进度"
                                    ValueChanged="MediaProgress_ValueChanged" />
                                <TextBlock
                                    x:Name="MediaDuration"
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                    FontSize="10"
                                    Text="0:00" />
                            </Grid>

                            <StackPanel
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="10">
                                <Button
                                    x:Name="MediaPreviousButton"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    AutomationProperties.Name="上一首"
                                    Click="MediaPreviousButton_Click"
                                    ToolTipService.ToolTip="上一首">
                                    <FontIcon FontSize="15" Glyph="&#xE892;" />
                                </Button>
                                <Button
                                    x:Name="MediaPlayPauseButton"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    AutomationProperties.Name="暂停"
                                    Click="MediaPlayPauseButton_Click"
                                    ToolTipService.ToolTip="暂停">
                                    <FontIcon
                                        x:Name="MediaPlayPauseIcon"
                                        FontSize="17"
                                        Glyph="&#xE769;" />
                                </Button>
                                <Button
                                    x:Name="MediaNextButton"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    AutomationProperties.Name="下一首"
                                    Click="MediaNextButton_Click"
                                    ToolTipService.ToolTip="下一首">
                                    <FontIcon FontSize="15" Glyph="&#xE893;" />
                                </Button>
                            </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                        <Grid
                            x:Name="ShelfView"
                            Grid.Row="1"
                            AllowDrop="True"
                            AutomationProperties.Name="文件中转站"
                            DragLeave="ShelfView_DragLeave"
                            DragOver="ShelfView_DragOver"
