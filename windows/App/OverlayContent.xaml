                                                        PlaceholderText="可选" />
                                                </Grid>

                                                <StackPanel
                                                    HorizontalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="4">
                                                    <ToggleButton x:Name="AlarmSunday" Width="36" Height="30" Content="日" Tag="1" Click="AlarmWeekdayButton_Click" />
                                                    <ToggleButton x:Name="AlarmMonday" Width="36" Height="30" Content="一" Tag="2" Click="AlarmWeekdayButton_Click" />
                                                    <ToggleButton x:Name="AlarmTuesday" Width="36" Height="30" Content="二" Tag="3" Click="AlarmWeekdayButton_Click" />
                                                    <ToggleButton x:Name="AlarmWednesday" Width="36" Height="30" Content="三" Tag="4" Click="AlarmWeekdayButton_Click" />
                                                    <ToggleButton x:Name="AlarmThursday" Width="36" Height="30" Content="四" Tag="5" Click="AlarmWeekdayButton_Click" />
                                                    <ToggleButton x:Name="AlarmFriday" Width="36" Height="30" Content="五" Tag="6" Click="AlarmWeekdayButton_Click" />
                                                    <ToggleButton x:Name="AlarmSaturday" Width="36" Height="30" Content="六" Tag="7" Click="AlarmWeekdayButton_Click" />
                                                </StackPanel>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        x:Name="AlarmRepeatHint"
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                        FontSize="11"
                                                        Text="仅响一次" />
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="6">
                                                        <Button
                                                            x:Name="AlarmCancelButton"
                                                            Content="取消"
                                                            Click="AlarmCancelButton_Click"
                                                            Visibility="Collapsed" />
                                                        <Button
                                                            x:Name="AlarmSaveButton"
                                                            Click="AlarmSaveButton_Click">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                                                <TextBlock x:Name="AlarmSaveText" Text="添加" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock
                                                    x:Name="AlarmError"
                                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                    FontSize="11"
                                                    MaxLines="2"
                                                    TextWrapping="Wrap"
                                                    Visibility="Collapsed" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Glyph="&#xE823;" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="8,0"
                                            VerticalAlignment="Center"
                                            Spacing="1">
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="闹钟" />
                                            <TextBlock
                                                x:Name="AlarmButtonDetail"
                                                Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                FontSize="10"
                                                Text="暂无已启用闹钟"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <FontIcon
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                            FontSize="10"
                                            Glyph="&#xE70D;" />
                                    </Grid>
                                </Button>
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        MinWidth="168"
                                        Height="44"
                                        AutomationProperties.Name="打开提词器"
                                        Click="TeleprompterButton_Click"
                                        ToolTipService.ToolTip="打开提词器">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon FontSize="14" Glyph="&#xE8D2;" />
                                            <TextBlock Text="提词器" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        MinWidth="168"
                                        Height="44"
                                        AutomationProperties.Name="打开摄像头镜子"
                                        Click="CameraMirrorButton_Click"
                                        ToolTipService.ToolTip="打开摄像头镜子">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon FontSize="14" Glyph="&#xE722;" />
                                            <TextBlock Text="镜子" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <ScrollViewer
                            x:Name="SystemView"
                            Grid.Row="1"
                            AutomationProperties.Name="系统监控"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="Collapsed">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        x:Name="SystemCPUSection"
                                        Padding="10"
                                        Background="{ThemeResource OverlayCardBrush}"
                                        BorderBrush="{ThemeResource OverlayStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <StackPanel Spacing="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Text="CPU" />
                                                <TextBlock
                                                    x:Name="SystemCPUUsage"
                                                    Grid.Column="1"
                                                    FontFamily="Consolas"
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Text="" />
                                            </Grid>
                                            <TextBlock
                                                x:Name="SystemCPUName"
                                                Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                FontSize="9"
                                                MaxLines="1"
                                                Text=""
                                                TextTrimming="CharacterEllipsis" />
                                            <ProgressBar
                                                x:Name="SystemCPUProgress"
                                                Height="3"
                                                Maximum="1" />
                                            <Border
                                                Background="{ThemeResource OverlayOpaqueSurfaceBrush}"
                                                BorderBrush="{ThemeResource OverlayStrokeBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="7,5">
                                                <Grid Height="78">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Border
                                                        Height="1"
                                                        VerticalAlignment="Top"
                                                        Background="{ThemeResource OverlayStrokeBrush}" />
                                                    <Border
                                                        Grid.Row="1"
                                                        Height="1"
                                                        VerticalAlignment="Top"
                                                        Background="{ThemeResource OverlayStrokeBrush}" />
                                                    <Border
                                                        Grid.Row="2"
                                                        Height="1"
                                                        VerticalAlignment="Top"
                                                        Background="{ThemeResource OverlayStrokeBrush}" />
                                                    <Border
                                                        Grid.Row="3"
                                                        Height="1"
                                                        VerticalAlignment="Bottom"
                                                        Background="{ThemeResource OverlayStrokeBrush}" />
                                                    <Canvas
                                                        x:Name="SystemCPUHistoryCanvas"
                                                        Grid.RowSpan="4"
                                                        IsHitTestVisible="False">
                                                        <Polyline
                                                            x:Name="SystemCPUIdleHistoryLine"
                                                            Stroke="{ThemeResource OverlaySecondaryTextBrush}"
                                                            StrokeLineJoin="Round"
                                                            StrokeThickness="1.2" />
                                                        <Polyline
                                                            x:Name="SystemCPUSystemHistoryLine"
                                                            Stroke="{ThemeResource OverlayDangerBrush}"
                                                            StrokeLineJoin="Round"
                                                            StrokeThickness="1.4" />
                                                        <Polyline
                                                            x:Name="SystemCPUUserHistoryLine"
                                                            Stroke="{ThemeResource OverlayAccentBrush}"
                                                            StrokeLineJoin="Round"
                                                            StrokeThickness="1.5" />
                                                    </Canvas>
                                                    <TextBlock
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Padding="2,0"
                                                        Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                        FontFamily="Consolas"
                                                        FontSize="8"
                                                        Text="100%" />
                                                    <TextBlock
                                                        Grid.Row="2"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Padding="2,0"
                                                        Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                        FontFamily="Consolas"
                                                        FontSize="8"
                                                        Text="50%" />
                                                    <TextBlock
                                                        Grid.Row="3"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Padding="2,0"
                                                        Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                        FontFamily="Consolas"
                                                        FontSize="8"
                                                        Text="0%" />
                                                </Grid>
                                            </Border>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                    FontSize="8"
                                                    Text="最近 60 秒" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                    FontSize="8"
                                                    Text="处理器占用" />
                                            </Grid>
                                            <StackPanel
                                                x:Name="SystemCPUDetail"
                                                Orientation="Horizontal"
                                                Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Ellipse
                                                        Width="6"
                                                        Height="6"
                                                        VerticalAlignment="Center"
                                                        Fill="{ThemeResource OverlayAccentBrush}" />
                                                    <TextBlock
                                                        x:Name="SystemCPUUserDetail"
                                                        Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                        FontSize="9" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Ellipse
                                                        Width="6"
                                                        Height="6"
                                                        VerticalAlignment="Center"
                                                        Fill="{ThemeResource OverlayDangerBrush}" />
                                                    <TextBlock
                                                        x:Name="SystemCPUSystemDetail"
                                                        Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                        FontSize="9" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Ellipse
                                                        Width="6"
                                                        Height="6"
                                                        VerticalAlignment="Center"
                                                        Fill="{ThemeResource OverlaySecondaryTextBrush}" />
                                                    <TextBlock
                                                        x:Name="SystemCPUIdleDetail"
                                                        Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                        FontSize="9" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        x:Name="SystemGPUSection"
                                        Grid.Column="1"
                                        Padding="10"
                                        Background="{ThemeResource OverlayCardBrush}"
                                        BorderBrush="{ThemeResource OverlayStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <StackPanel Spacing="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Text="GPU" />
                                                <TextBlock
                                                    x:Name="SystemGPUUsage"
                                                    Grid.Column="1"
                                                    FontFamily="Consolas"
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Text="" />
                                            </Grid>
                                            <TextBlock
                                                x:Name="SystemGPUName"
                                                Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                FontSize="9"
                                                MaxLines="1"
                                                Text=""
                                                TextTrimming="CharacterEllipsis" />
                                            <ProgressBar
                                                x:Name="SystemGPUProgress"
                                                Height="3"
                                                Maximum="1" />
                                            <Border
                                                Background="{ThemeResource OverlayOpaqueSurfaceBrush}"
                                                BorderBrush="{ThemeResource OverlayStrokeBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="7,5">
                                                <Grid Height="78">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Border
                                                        Height="1"
                                                        VerticalAlignment="Top"
                                                        Background="{ThemeResource OverlayStrokeBrush}" />
                                                    <Border
                                                        Grid.Row="1"
                                                        Height="1"
                                                        VerticalAlignment="Top"
                                                        Background="{ThemeResource OverlayStrokeBrush}" />
                                                    <Border
                                                        Grid.Row="2"
                                                        Height="1"
                                                        VerticalAlignment="Top"
                                                        Background="{ThemeResource OverlayStrokeBrush}" />
                                                    <Border
                                                        Grid.Row="3"
                                                        Height="1"
                                                        VerticalAlignment="Bottom"
                                                        Background="{ThemeResource OverlayStrokeBrush}" />
                                                    <Canvas
                                                        x:Name="SystemGPUHistoryCanvas"
                                                        Grid.RowSpan="4"
                                                        IsHitTestVisible="False">
                                                        <Polyline
                                                            x:Name="SystemGPUHistoryLine"
                                                            Stroke="{ThemeResource SystemFillColorSuccessBrush}"
                                                            StrokeLineJoin="Round"
                                                            StrokeThickness="1.5" />
                                                    </Canvas>
                                                    <TextBlock
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Padding="2,0"
                                                        Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                        FontFamily="Consolas"
                                                        FontSize="8"
                                                        Text="100%" />
                                                    <TextBlock
                                                        Grid.Row="2"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Padding="2,0"
                                                        Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                        FontFamily="Consolas"
                                                        FontSize="8"
                                                        Text="50%" />
                                                    <TextBlock
                                                        Grid.Row="3"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Padding="2,0"
                                                        Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                        FontFamily="Consolas"
                                                        FontSize="8"
                                                        Text="0%" />
                                                </Grid>
                                            </Border>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                    FontSize="8"
                                                    Text="最近 60 秒" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="4">
                                                    <Ellipse
                                                        Width="6"
                                                        Height="6"
                                                        VerticalAlignment="Center"
                                                        Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                        FontSize="8"
                                                        Text="利用率" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock
                                                x:Name="SystemGPUDetail"
                                                Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                                FontSize="9"
                                                Text=""
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border
                                    x:Name="SystemResourceSeparator"
                                    Height="1"
                                    Background="{ThemeResource OverlayStrokeBrush}" />

                                <StackPanel x:Name="SystemMemorySection" Spacing="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="内存" />
                                        <TextBlock
                                            x:Name="SystemMemoryUsage"
                                            Grid.Column="1"
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Text="" />
                                    </Grid>
                                    <ProgressBar
                                        x:Name="SystemMemoryProgress"
                                        Height="3"
                                        Maximum="1" />
                                    <TextBlock
                                        x:Name="SystemMemoryDetail"
                                        Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                        FontSize="9"
                                        Text="" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressRing
                                            x:Name="SystemMemoryTrimProgress"
                                            Width="14"
                                            Height="14"
                                            VerticalAlignment="Center"
                                            IsActive="False"
                                            Visibility="Collapsed" />
                                        <TextBlock
                                            x:Name="SystemMemoryTrimStatusText"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                            FontSize="9"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="Collapsed" />
                                        <Button
                                            x:Name="SystemMemoryTrimButton"
                                            Grid.Column="2"
                                            Height="30"
                                            Padding="9,0"
                                            AutomationProperties.Name="释放系统内存"
                                            Click="SystemMemoryReleaseButton_Click"
                                            ToolTipService.ToolTip="请求 Windows 回收系统内存；不会结束应用程序，但其他应用可能短暂重新加载数据">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon FontSize="11" Glyph="&#xE950;" />
                                                <TextBlock FontSize="10" Text="释放系统内存" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <StackPanel x:Name="SystemDiskSection" Spacing="4">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="磁盘" />
                                        <TextBlock
                                            x:Name="SystemDiskUsage"
                                            Grid.Column="1"
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Text="" />
                                        <Button
                                            x:Name="DiskCleanupScanButton"
                                            Grid.Column="2"
                                            Height="30"
                                            Padding="9,0"
                                            AutomationProperties.Name="扫描可清理项目"
                                            Click="DiskCleanupScanButton_Click"
                                            ToolTipService.ToolTip="扫描可安全移入回收站的临时文件和缓存">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon FontSize="11" Glyph="&#xE721;" />
                                                <TextBlock FontSize="10" Text="清理" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock
                                        x:Name="SystemDiskDetail"
                                        Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                        FontSize="9"
                                        Text=""
                                        TextWrapping="Wrap" />
                                    <StackPanel x:Name="SystemDiskVolumes" Spacing="6" />
                                    <StackPanel
                                        x:Name="DiskCleanupInlineContent"
                                        Spacing="8"
                                        Visibility="Collapsed">
                                    <ProgressBar
                                        x:Name="DiskCleanupProgress"
                                        Height="3"
                                        IsIndeterminate="True"
                                        Visibility="Collapsed" />
                                    <TextBlock
                                        x:Name="DiskCleanupEmptyText"
                                        HorizontalAlignment="Center"
                                        Margin="0,4"
                                        Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                        FontSize="10"
                                        Text="尚未扫描" />
                                    <ScrollViewer
                                        x:Name="DiskCleanupScroll"
                                        MaxHeight="168"
                                        VerticalScrollBarVisibility="Auto"
                                        Visibility="Collapsed">
                                        <StackPanel x:Name="DiskCleanupRows" Spacing="2" />
                                    </ScrollViewer>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="DiskCleanupSelectionText"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                            FontSize="9"
                                            Text="未选择项目" />
                                        <Button
                                            x:Name="DiskCleanupCleanButton"
                                            Grid.Column="1"
                                            Height="32"
                                            Padding="10,0"
                                            AutomationProperties.Name="将所选项目移入回收站"
                                            Click="DiskCleanupCleanButton_Click"
                                            IsEnabled="False">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                                <TextBlock FontSize="11" Text="移入回收站" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock
                                        x:Name="DiskCleanupStatusText"
                                        Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                        FontSize="9"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Height="1" Background="{ThemeResource OverlayStrokeBrush}" />

                                <Grid x:Name="SystemNetworkSection" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="SystemNetworkTraffic" Spacing="2">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="网络" />
                                        <TextBlock
                                            x:Name="SystemNetworkDownload"
                                            FontFamily="Consolas"
                                            FontSize="10"
                                            Text="" />
                                        <TextBlock
                                            x:Name="SystemNetworkUpload"
                                            FontFamily="Consolas"
                                            FontSize="10"
                                            Text="" />
                                    </StackPanel>
                                    <StackPanel
                                        x:Name="SystemNetworkAddresses"
                                        Grid.Column="1"
                                        Spacing="2">
                                        <TextBlock
                                            x:Name="SystemPrivateIP"
                                            Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                            FontSize="9"
                                            Text=""
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            x:Name="SystemPublicIP"
                                            Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                            FontSize="9"
                                            Text=""
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="SystemPowerPanel" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="SystemBattery"
                                        FontSize="9"
                                        Text=""
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="SystemUptime"
                                        Grid.Column="1"
                                        FontSize="9"
                                        Text=""
                                        TextWrapping="Wrap" />
                                </Grid>

                                <TextBlock
                                    x:Name="SystemSensorStatus"
                                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                                    FontSize="9"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>
                        <ScrollViewer
                            x:Name="AITaskScroll"
                            Grid.Row="1"
                            AutomationProperties.Name="进行中的 AI 任务"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="Collapsed">
                            <StackPanel x:Name="AITaskRows" Spacing="0" />
                        </ScrollViewer>
                    </Grid>
                </NavigationView>
            </Grid>
        </Grid>
    </Border>
</UserControl>
