<UserControl
    x:Class="Zisla.AIAgentSkillsContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer
        AutomationProperties.Name="AI Agent Skills"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="0,2,0,0" Spacing="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock
                        Foreground="{ThemeResource OverlayPrimaryTextBrush}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="Skills" />
                    <TextBlock
                        x:Name="SkillsStatusText"
                        Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                        FontSize="10"
                        Text="正在扫描 Skills"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button
                    x:Name="OpenLibraryButton"
                    Grid.Column="1"
                    Width="34"
                    Height="34"
                    Padding="0"
                    AutomationProperties.Name="打开 Skills 受管库"
                    Click="OpenLibraryButton_Click"
                    ToolTipService.ToolTip="打开 Skills 受管库">
                    <FontIcon FontSize="13" Glyph="&#xE838;" />
                </Button>
                <Button
                    x:Name="RefreshButton"
                    Grid.Column="2"
                    Width="34"
                    Height="34"
                    Margin="4,0,0,0"
                    Padding="0"
                    AutomationProperties.Name="刷新 Skills"
                    Click="RefreshButton_Click"
                    ToolTipService.ToolTip="刷新 Skills">
                    <FontIcon FontSize="13" Glyph="&#xE72C;" />
                </Button>
                <Button
                    x:Name="SynchronizeButton"
                    Grid.Column="3"
                    Width="34"
                    Height="34"
                    Margin="4,0,0,0"
                    Padding="0"
                    AutomationProperties.Name="同步 Skills"
                    Click="SynchronizeButton_Click"
                    ToolTipService.ToolTip="同步 Skills">
                    <FontIcon FontSize="13" Glyph="&#xE895;" />
                </Button>
            </Grid>

            <TextBlock
                x:Name="SkillsErrorText"
                Foreground="{ThemeResource OverlayDangerBrush}"
                FontSize="10"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <StackPanel Spacing="3">
                <TextBlock
                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                    FontSize="10"
                    Text="受管库" />
                <TextBlock
                    x:Name="ManagedLibraryPathText"
                    Foreground="{ThemeResource OverlayPrimaryTextBrush}"
                    FontFamily="Consolas"
                    FontSize="10"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock
                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                    FontSize="10"
                    Text="同步方式" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <RadioButton
                        x:Name="FileCopyModeButton"
                        AutomationProperties.Name="文件复制同步方式"
                        Click="SyncModeButton_Click"
                        Content="文件复制"
                        GroupName="SkillsSyncMode"
                        Tag="file-copy" />
                    <RadioButton
                        x:Name="SymbolicLinkModeButton"
                        AutomationProperties.Name="符号链接同步方式"
                        Click="SyncModeButton_Click"
                        Content="符号链接"
                        GroupName="SkillsSyncMode"
                        Tag="symbolic-link" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="3">
                <TextBlock
                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                    FontSize="10"
                    Text="同步目标" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleSwitch
                        x:Name="CodexDestinationToggle"
                        Width="42"
                        AutomationProperties.Name="同步到 Codex"
                        OffContent=""
                        OnContent=""
                        Tag="codex"
                        Toggled="DestinationToggle_Toggled" />
                    <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock
                            Foreground="{ThemeResource OverlayPrimaryTextBrush}"
                            FontSize="11"
                            Text="Codex" />
                        <TextBlock
                            x:Name="CodexDestinationPathText"
                            Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                            FontFamily="Consolas"
                            FontSize="9"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleSwitch
                        x:Name="ClaudeDestinationToggle"
                        Width="42"
                        AutomationProperties.Name="同步到 Claude Code"
                        OffContent=""
                        OnContent=""
                        Tag="claude"
                        Toggled="DestinationToggle_Toggled" />
                    <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock
                            Foreground="{ThemeResource OverlayPrimaryTextBrush}"
                            FontSize="11"
                            Text="Claude Code" />
                        <TextBlock
                            x:Name="ClaudeDestinationPathText"
                            Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                            FontFamily="Consolas"
                            FontSize="9"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleSwitch
                        x:Name="AgentsDestinationToggle"
                        Width="42"
                        AutomationProperties.Name="同步到 Agents"
                        OffContent=""
                        OnContent=""
                        Tag="agents"
                        Toggled="DestinationToggle_Toggled" />
                    <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock
                            Foreground="{ThemeResource OverlayPrimaryTextBrush}"
                            FontSize="11"
                            Text="Agents" />
                        <TextBlock
                            x:Name="AgentsDestinationPathText"
                            Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                            FontFamily="Consolas"
                            FontSize="9"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock
                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                    FontSize="10"
                    Text="已发现的 Skills" />
                <TextBlock
                    x:Name="SkillsEmptyText"
                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                    FontSize="11"
                    Text="暂无可用 Skills"
                    Visibility="Collapsed" />
                <StackPanel x:Name="SkillRows" Spacing="2" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
