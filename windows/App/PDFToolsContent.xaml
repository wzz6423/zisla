<UserControl
    x:Class="Zisla.PDFToolsContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer
        AutomationProperties.Name="PDF 工具"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="0,2,0,0" Spacing="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock
                        Foreground="{ThemeResource OverlayPrimaryTextBrush}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="PDF 工具" />
                    <TextBlock
                        x:Name="PDFStatusText"
                        Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                        FontSize="10"
                        Text="请选择 PDF 文件"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ProgressRing
                    x:Name="PDFProgressRing"
                    Grid.Column="1"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock
                        Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                        FontSize="10"
                        Text="输入文件" />
                    <TextBlock
                        x:Name="PDFInputText"
                        Foreground="{ThemeResource OverlayPrimaryTextBrush}"
                        FontSize="11"
                        Text="尚未选择"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button
                    x:Name="PDFChooseInputsButton"
                    Grid.Column="1"
                    Height="32"
                    Padding="10,0"
                    AutomationProperties.Name="选择输入文件"
                    Click="ChooseInputsButton_Click"
                    ToolTipService.ToolTip="选择输入文件">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon FontSize="12" Glyph="&#xE8B7;" />
                        <TextBlock FontSize="11" Text="选择" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock
                x:Name="PDFSummaryText"
                Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                FontSize="10"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <ComboBox
                x:Name="PDFOperationPicker"
                AutomationProperties.Name="PDF 操作"
                PlaceholderText="选择操作"
                SelectedIndex="0"
                SelectionChanged="OperationPicker_SelectionChanged">
                <ComboBoxItem Content="读取 PDF 信息" Tag="inspect" />
                <ComboBoxItem Content="读取元数据" Tag="read_metadata" />
                <ComboBoxItem Content="合并 PDF" Tag="merge" />
                <ComboBoxItem Content="导出页面" Tag="export_pages" />
                <ComboBoxItem Content="拆分 PDF" Tag="split" />
                <ComboBoxItem Content="旋转页面" Tag="rotate" />
                <ComboBoxItem Content="裁剪页面" Tag="crop" />
                <ComboBoxItem Content="更新元数据" Tag="update_metadata" />
                <ComboBoxItem Content="设置密码" Tag="protect" />
                <ComboBoxItem Content="解除密码" Tag="unlock" />
                <ComboBoxItem Content="导出文字" Tag="export_text" />
                <ComboBoxItem Content="渲染为图片" Tag="render_pages" />
                <ComboBoxItem Content="图片转 PDF" Tag="images_to_pdf" />
                <ComboBoxItem Content="添加文字水印" Tag="text_watermark" />
                <ComboBoxItem Content="添加图片水印" Tag="image_watermark" />
                <ComboBoxItem Content="添加页码" Tag="page_numbers" />
                <ComboBoxItem Content="Office 转 PDF" Tag="office_to_pdf" />
            </ComboBox>

            <StackPanel x:Name="PDFPagesPanel" Spacing="4" Visibility="Collapsed">
                <TextBlock
                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                    FontSize="10"
                    Text="页码范围" />
                <TextBox
                    x:Name="PDFPageRangeBox"
                    AutomationProperties.Name="PDF 页码范围"
                    PlaceholderText="例如：1-3,5"
                    Text="1" />
            </StackPanel>

            <StackPanel x:Name="PDFSplitPanel" Spacing="4" Visibility="Collapsed">
                <TextBlock
                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                    FontSize="10"
                    Text="拆分分组" />
                <TextBox
                    x:Name="PDFSplitRangesBox"
                    AutomationProperties.Name="PDF 拆分分组"
                    PlaceholderText="例如：1-2;3-4"
                    Text="1" />
            </StackPanel>

            <StackPanel x:Name="PDFRotationPanel" Spacing="4" Visibility="Collapsed">
                <TextBlock
                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                    FontSize="10"
                    Text="旋转角度" />
                <ComboBox
                    x:Name="PDFRotationPicker"
                    AutomationProperties.Name="PDF 旋转角度"
                    SelectedIndex="0">
                    <ComboBoxItem Content="顺时针 90 度" Tag="90" />
                    <ComboBoxItem Content="180 度" Tag="180" />
                    <ComboBoxItem Content="逆时针 90 度" Tag="-90" />
                </ComboBox>
            </StackPanel>

            <StackPanel x:Name="PDFCropPanel" Spacing="4" Visibility="Collapsed">
                <TextBlock
                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                    FontSize="10"
                    Text="裁剪框（PDF 点）" />
                <Grid ColumnSpacing="6" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="PDFCropXBox" AutomationProperties.Name="裁剪起点 X" Header="X" PlaceholderText="0" />
                    <TextBox x:Name="PDFCropYBox" Grid.Column="1" AutomationProperties.Name="裁剪起点 Y" Header="Y" PlaceholderText="0" />
                    <TextBox x:Name="PDFCropWidthBox" Grid.Row="1" AutomationProperties.Name="裁剪宽度" Header="宽度" PlaceholderText="612" />
                    <TextBox x:Name="PDFCropHeightBox" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="裁剪高度" Header="高度" PlaceholderText="792" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="PDFMetadataPanel" Spacing="6" Visibility="Collapsed">
                <TextBox x:Name="PDFTitleBox" AutomationProperties.Name="PDF 标题" Header="标题" />
                <TextBox x:Name="PDFAuthorBox" AutomationProperties.Name="PDF 作者" Header="作者" />
                <TextBox x:Name="PDFSubjectBox" AutomationProperties.Name="PDF 主题" Header="主题" />
                <TextBox x:Name="PDFCreatorBox" AutomationProperties.Name="PDF 创建程序" Header="创建程序" />
                <TextBox x:Name="PDFKeywordsBox" AutomationProperties.Name="PDF 关键词" Header="关键词" PlaceholderText="逗号分隔" />
                <TextBlock
                    x:Name="PDFMetadataSummaryText"
                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                    FontSize="10"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>

            <StackPanel x:Name="PDFProtectionPanel" Spacing="6" Visibility="Collapsed">
                <PasswordBox
                    x:Name="PDFUserPasswordBox"
                    AutomationProperties.Name="PDF 打开密码"
                    Header="打开密码" />
                <PasswordBox
                    x:Name="PDFOwnerPasswordBox"
                    AutomationProperties.Name="PDF 权限密码"
                    Header="权限密码" />
            </StackPanel>

            <StackPanel x:Name="PDFUnlockPanel" Spacing="4" Visibility="Collapsed">
                <PasswordBox
                    x:Name="PDFUnlockPasswordBox"
                    AutomationProperties.Name="PDF 当前密码"
                    Header="当前密码" />
            </StackPanel>

            <StackPanel x:Name="PDFRenderPanel" Spacing="6" Visibility="Collapsed">
                <TextBlock
                    Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                    FontSize="10"
                    Text="渲染设置" />
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="PDFRenderFormatPicker"
                        AutomationProperties.Name="渲染图片格式"
                        Header="格式"
                        SelectedIndex="0">
                        <ComboBoxItem Content="PNG" Tag="png" />
                        <ComboBoxItem Content="JPEG" Tag="jpeg" />
                    </ComboBox>
                    <TextBox
                        x:Name="PDFRenderDpiBox"
                        Grid.Column="1"
                        AutomationProperties.Name="渲染 DPI"
                        Header="DPI"
                        Text="144" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="PDFTextWatermarkPanel" Spacing="6" Visibility="Collapsed">
                <TextBox
                    x:Name="PDFTextWatermarkTextBox"
                    AutomationProperties.Name="文字水印内容"
                    Header="水印文字" />
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="PDFTextWatermarkFontSizeBox"
                        AutomationProperties.Name="文字水印字号"
                        Header="字号"
                        Text="42" />
                    <TextBox
                        x:Name="PDFTextWatermarkOpacityBox"
                        Grid.Column="1"
                        AutomationProperties.Name="文字水印透明度"
                        Header="透明度"
                        Text="0.22" />
                    <TextBox
                        x:Name="PDFTextWatermarkRotationBox"
                        Grid.Column="2"
                        AutomationProperties.Name="文字水印旋转角度"
                        Header="旋转"
                        Text="-35" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="PDFImageWatermarkPanel" Spacing="6" Visibility="Collapsed">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="PDFImageWatermarkPathBox"
                        AutomationProperties.Name="图片水印文件"
                        Header="水印图片"
                        IsReadOnly="True"
                        PlaceholderText="请选择 PNG 或 JPEG" />
                    <Button
                        x:Name="PDFChooseWatermarkImageButton"
                        Grid.Column="1"
                        Height="32"
                        Padding="10,0"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="选择图片水印"
                        Click="ChooseWatermarkImageButton_Click"
                        ToolTipService.ToolTip="选择图片水印">
                        <FontIcon FontSize="13" Glyph="&#xE8B7;" />
                    </Button>
                </Grid>
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="PDFImageWatermarkPositionPicker"
                        AutomationProperties.Name="图片水印位置"
                        Header="位置"
                        SelectedIndex="0">
                        <ComboBoxItem Content="居中" Tag="center" />
                        <ComboBoxItem Content="左上" Tag="top_leading" />
                        <ComboBoxItem Content="右上" Tag="top_trailing" />
                        <ComboBoxItem Content="左下" Tag="bottom_leading" />
                        <ComboBoxItem Content="右下" Tag="bottom_trailing" />
                    </ComboBox>
                    <TextBox
                        x:Name="PDFImageWatermarkScaleBox"
                        Grid.Column="1"
                        AutomationProperties.Name="图片水印缩放"
                        Header="缩放"
                        Text="0.25" />
                    <TextBox
                        x:Name="PDFImageWatermarkOpacityBox"
                        Grid.Column="2"
                        AutomationProperties.Name="图片水印透明度"
                        Header="透明度"
                        Text="0.3" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="PDFPageNumbersPanel" Spacing="6" Visibility="Collapsed">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="PDFPageNumberPrefixBox"
                        AutomationProperties.Name="页码前缀"
                        Header="前缀"
                        Text="第 " />
                    <TextBox
                        x:Name="PDFPageNumberSuffixBox"
                        Grid.Column="1"
                        AutomationProperties.Name="页码后缀"
                        Header="后缀"
                        Text=" 页" />
                </Grid>
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="PDFPageNumberPositionPicker"
                        AutomationProperties.Name="页码位置"
                        Header="位置"
                        SelectedIndex="0">
                        <ComboBoxItem Content="底部居中" Tag="bottom" />
                        <ComboBoxItem Content="顶部居中" Tag="top" />
                        <ComboBoxItem Content="左下" Tag="bottom_leading" />
                        <ComboBoxItem Content="右下" Tag="bottom_trailing" />
                    </ComboBox>
                    <TextBox
                        x:Name="PDFPageNumberFontSizeBox"
                        Grid.Column="1"
                        AutomationProperties.Name="页码字号"
                        Header="字号"
                        Text="11" />
                    <TextBox
                        x:Name="PDFPageNumberInsetBox"
                        Grid.Column="2"
                        AutomationProperties.Name="页码边距"
                        Header="边距"
                        Text="24" />
                </Grid>
            </StackPanel>

            <Grid x:Name="PDFOutputPanel" ColumnSpacing="8" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Name="PDFOutputFolderText"
                        Foreground="{ThemeResource OverlaySecondaryTextBrush}"
                        FontSize="10"
                        Text="请选择输出文件夹"
                        TextTrimming="CharacterEllipsis" />
                    <TextBox
                        x:Name="PDFOutputNameBox"
                        AutomationProperties.Name="输出文件名"
                        PlaceholderText="output.pdf" />
                </StackPanel>
                <Button
                    x:Name="PDFChooseOutputFolderButton"
                    Grid.Column="1"
                    Height="32"
                    Padding="10,0"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="选择 PDF 输出文件夹"
                    Click="ChooseOutputFolderButton_Click"
                    ToolTipService.ToolTip="选择输出文件夹">
                    <FontIcon FontSize="13" Glyph="&#xE838;" />
                </Button>
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="PDFRunButton"
                    Height="34"
                    AutomationProperties.Name="执行 PDF 操作"
                    Click="RunButton_Click">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="13" Glyph="&#xE768;" />
                        <TextBlock x:Name="PDFRunButtonText" Text="读取信息" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="PDFResetButton"
                    Grid.Column="1"
                    Width="34"
                    Height="34"
                    Padding="0"
                    AutomationProperties.Name="清除 PDF 选择"
                    Click="ResetButton_Click"
                    ToolTipService.ToolTip="清除选择">
                    <FontIcon FontSize="13" Glyph="&#xE74D;" />
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
