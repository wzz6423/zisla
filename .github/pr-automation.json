{
  "comment": "Pull request metadata contract shared by the PR Quality check and the PR Automation workflow. Labels missing from the repository are created with the color and description declared here.",
  "project": { "name": "zisla Development" },
  "types": [
    { "type": "feat", "aliases": ["feature"], "label": "enhancement", "color": "a2eeef", "description": "New feature or request" },
    { "type": "fix", "aliases": ["bug-fix", "bugfix", "hot-fix", "hotfix"], "label": "bug", "color": "d73a4a", "description": "Something isn't working" },
    { "type": "docs", "aliases": ["doc"], "label": "documentation", "color": "0075ca", "description": "Improvements or additions to documentation" },
    { "type": "style", "label": "style", "color": "c5def5", "description": "Formatting only, no behavior change" },
    { "type": "refactor", "label": "refactor", "color": "fbca04", "description": "Restructuring without behavior change" },
    { "type": "perf", "label": "performance", "color": "0e8a16", "description": "Performance improvement" },
    { "type": "test", "label": "test", "color": "bfd4f2", "description": "Tests only" },
    { "type": "chore", "label": "chore", "color": "ededed", "description": "Maintenance work" },
    { "type": "build", "label": "build", "color": "5319e7", "description": "Build system or packaging" },
    { "type": "ci", "label": "ci", "color": "1d76db", "description": "Continuous integration and automation" },
    { "type": "revert", "label": "revert", "color": "b60205", "description": "Reverts a previous change" }
  ],
  "issueLabel": {
    "label": "development",
    "color": "0052cc",
    "description": "Linked to an issue through the Development section"
  },
  "aiLabel": {
    "label": "ai-assisted",
    "color": "8250df",
    "description": "An AI agent co-authored this change"
  },
  "skipLabel": {
    "label": "skip-ci",
    "color": "e99695",
    "description": "CI runs were skipped by an authorized skip directive"
  }
}
