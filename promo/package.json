{
  "name": "zisla-promo",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion source for the zisla launch film.",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "test": "node --test tools/*.test.mjs",
    "render": "remotion render ZislaLaunchFilm out/zisla-launch-1080p60.mp4",
    "render:4k": "remotion render ZislaLaunchFilm4K out/zisla-launch-2160p60.mp4",
    "still": "remotion still ZislaLaunchFilm"
  },
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "@remotion/tailwind-v4": "4.0.542",
    "lucide-react": "1.71.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  }
}
